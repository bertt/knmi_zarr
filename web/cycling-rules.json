{
  "_help": [
    "Rules for web/cycling.html. Edit freely; the page reads this file on every load.",
    "A 'band' list is evaluated top to bottom: the first band where value <= upTo applies (upTo null = everything above).",
    "Units: temperature in degC, wind and gusts in m/s, rain in mm (1h/6h/24h) or mm/h (now), radiation in W/m2, visibility in m.",
    "hail is 0 (none) to 4 (severe), derived from the KNMI weather code since hail size is not measured.",
    "Inputs you can use: ta, td, rh, pp (sea-level pressure, hPa), rideTemp, ff, gust, qg, vv, n, ss, rainIntensity, rain1h, rain6h, rain24h, iceRisk, saltRisk, hail, snow, night, darkness (0-100, dusk to full dark), darkSoon.",
    "Scores: result = clamp(base + sum of band points, 0, 100). Cleaning: base + sum of points, then the highest level with min <= total."
  ],

  "ride": {
    "bikeOffsetC": -2,
    "rainOffsetC": -1.5,
    "rainThresholdMmH": 0.05,
    "dampOffsetC": -1,
    "dampSpreadBelowC": 2,
    "dampMaxTempC": 12,
    "windChillPerMs": 0.2,
    "windChillAboveMs": 4,
    "iceTempC": 1,
    "iceHumidityPct": 90,
    "saltTempC": 3,
    "darkSoonHours": 2,
    "twilightStartDeg": 4,
    "fullDarkDeg": -12,
    "dullMinCloudOctas": 7,
    "dullMaxWindMs": 2.5,
    "glareMaxElevationDeg": 12,
    "moonMaxCloudOctas": 2,
    "moonMinIlluminationPct": 50,
    "moonMinAltitudeDeg": 5
  },

  "scores": {
    "ride": {
      "title": "Ride score (average of comfort and training)",
      "base": 100,
      "rules": [
        { "id": "rain-now", "label": "Rain right now", "input": "rainIntensity", "unit": "mm/h", "dec": 1,
          "bands": [
            { "upTo": 0.05, "points": 0, "note": "Dry" },
            { "upTo": 0.5, "points": -20, "note": "Drizzle" },
            { "upTo": 2, "points": -37, "note": "Rain" },
            { "upTo": null, "points": -57, "note": "Heavy rain" }
          ] },
        { "id": "wet-roads", "label": "Rain last hour (wet roads)", "input": "rain1h", "unit": "mm", "dec": 1,
          "bands": [
            { "upTo": 0.1, "points": 0 },
            { "upTo": 1, "points": -10, "note": "Damp roads" },
            { "upTo": 3, "points": -18, "note": "Wet roads" },
            { "upTo": null, "points": -26, "note": "Soaked roads" }
          ] },
        { "id": "rain-6h", "label": "Rain last 6 hours", "input": "rain6h", "unit": "mm", "dec": 1,
          "bands": [
            { "upTo": 0.5, "points": 0 },
            { "upTo": 3, "points": -8, "note": "Wet roads" },
            { "upTo": null, "points": -16, "note": "Very wet roads" }
          ] },
        { "id": "rain-24h", "label": "Rain last 24 hours (wet and dirty roads)", "input": "rain24h", "unit": "mm", "dec": 1,
          "bands": [
            { "upTo": 1, "points": 0 },
            { "upTo": 5, "points": -4 },
            { "upTo": null, "points": -8, "note": "A lot of rain: wet, dirty roads" }
          ] },
        { "id": "temp", "label": "Temperature on the bike", "input": "rideTemp", "unit": "°C", "dec": 1,
          "bands": [
            { "upTo": -2, "points": -25, "note": "Freezing" },
            { "upTo": 2, "points": -10, "note": "Very cold" },
            { "upTo": 6, "points": 0, "note": "Cold" },
            { "upTo": 10, "points": 1, "note": "Chilly" },
            { "upTo": 12, "points": 1, "note": "Cool" },
            { "upTo": 14, "points": 3, "note": "Comfortable" },
            { "upTo": 22, "points": 0, "note": "Comfortable" },
            { "upTo": 24, "points": -2, "note": "Comfortable" },
            { "upTo": 28, "points": -5, "note": "Warm" },
            { "upTo": 32, "points": -15, "note": "Hot" },
            { "upTo": null, "points": -22, "note": "Very hot" }
          ] },
        { "id": "deep-cold", "label": "Deep cold (air below -10°C)", "input": "ta", "unit": "°C", "dec": 1,
          "bands": [
            { "upTo": -15, "points": -32, "note": "Dangerous cold" },
            { "upTo": -10, "points": -17, "note": "Too cold" },
            { "upTo": null, "points": 0 }
          ] },
        { "id": "hail", "label": "Hail (1 = small/soft, 4 = heavy with thunderstorm)", "input": "hail",
          "bands": [
            { "upTo": 0, "points": 0 },
            { "upTo": 1, "points": -17, "note": "Small hail" },
            { "upTo": 2, "points": -30, "note": "Hail" },
            { "upTo": 3, "points": -45, "note": "Heavy hail" },
            { "upTo": null, "points": -60, "note": "Severe hail, seek shelter" }
          ] },
        { "id": "heat", "label": "Heat (air above 30°C)", "input": "ta", "unit": "°C", "dec": 1,
          "bands": [
            { "upTo": 30, "points": 0 },
            { "upTo": 35, "points": -17, "note": "Too hot" },
            { "upTo": null, "points": -32, "note": "Dangerous heat" }
          ] },
        { "id": "wind", "label": "Wind", "input": "ff", "unit": "m/s", "dec": 1,
          "bands": [
            { "upTo": 2, "points": -2, "note": "Calm to light" },
            { "upTo": 4, "points": 3, "note": "Calm to light" },
            { "upTo": 5, "points": 0, "note": "Breezy" },
            { "upTo": 7, "points": 5, "note": "Breezy" },
            { "upTo": 8, "points": 0, "note": "Windy" },
            { "upTo": 10, "points": 5, "note": "Windy" },
            { "upTo": 11, "points": -2, "note": "Very windy" },
            { "upTo": 13, "points": -7, "note": "Very windy" },
            { "upTo": 14, "points": -15, "note": "Storm-like" },
            { "upTo": null, "points": -22, "note": "Storm-like" }
          ] },
        { "id": "gust", "label": "Gusts", "input": "gust", "unit": "m/s", "dec": 1,
          "bands": [
            { "upTo": 10, "points": 0 },
            { "upTo": 15, "points": -2 },
            { "upTo": 20, "points": -8 },
            { "upTo": null, "points": -17, "note": "Dangerous gusts" }
          ] },
        { "id": "pressure", "label": "Air pressure (sea level)", "input": "pp", "unit": "hPa", "dec": 0,
          "bands": [
            { "upTo": 995, "points": -3, "note": "Deep low: unsettled, wet and windy weather" },
            { "upTo": 1005, "points": -1, "note": "Low pressure: changeable weather" },
            { "upTo": 1020, "points": 0 },
            { "upTo": 1030, "points": 2, "note": "High pressure: stable weather" },
            { "upTo": null, "points": 3, "note": "Strong high: settled, calm weather" }
          ] },
        { "id": "sun", "label": "Sun (global radiation)", "input": "qg", "unit": "W/m²", "dec": 0,
          "bands": [
            { "upTo": 50, "points": 0 },
            { "upTo": 200, "points": 2 },
            { "upTo": 400, "points": 4, "note": "Some sun" },
            { "upTo": null, "points": 5, "note": "Sunny" }
          ] },
        { "id": "east-wind", "label": "Cold easterly wind", "input": "coldEastWind", "display": "flag",
          "bands": [
            { "upTo": 0, "points": 0 },
            { "upTo": null, "points": -2, "note": "Easterly wind feels extra cold" }
          ] },
        { "id": "glare", "label": "Low sun glare", "input": "sunGlare", "display": "flag",
          "bands": [
            { "upTo": 0, "points": 0 },
            { "upTo": null, "points": -1, "note": "Low sun: glare in your eyes" }
          ] },
        { "id": "leaves", "label": "Wet autumn leaves", "input": "leafRisk", "display": "flag",
          "bands": [
            { "upTo": 0, "points": 0 },
            { "upTo": null, "points": -3, "note": "Slippery leaves and mud on the road" }
          ] },
        { "id": "fog-cold", "label": "Fog and cold", "input": "foggyCold", "display": "flag",
          "bands": [
            { "upTo": 0, "points": 0 },
            { "upTo": null, "points": -4, "note": "Cold fog: damp, dark and slippery" }
          ] },
        { "id": "dull", "label": "Dull weather (overcast and no wind)", "input": "dull", "display": "flag",
          "bands": [
            { "upTo": 0, "points": 0 },
            { "upTo": null, "points": -5, "note": "Grey and windless: boring ride" }
          ] },
        { "id": "visibility", "label": "Visibility", "input": "vv", "unit": "m", "dec": 0,
          "bands": [
            { "upTo": 500, "points": -27, "note": "Dense fog" },
            { "upTo": 1000, "points": -16, "note": "Fog" },
            { "upTo": 1500, "points": -12, "note": "Mist" },
            { "upTo": 2000, "points": -8, "note": "Mist" },
            { "upTo": 4000, "points": -4, "note": "Hazy" },
            { "upTo": 5000, "points": -2, "note": "Hazy" },
            { "upTo": null, "points": 0 }
          ] },
        { "id": "dewpoint", "label": "Dew point (muggy)", "input": "td", "unit": "°C", "dec": 1,
          "bands": [
            { "upTo": 16, "points": 0 },
            { "upTo": 19, "points": -2, "note": "Humid" },
            { "upTo": null, "points": -4, "note": "Muggy" }
          ] },
        { "id": "ice", "label": "Ice risk (cold and damp)", "input": "iceRisk", "display": "flag",
          "bands": [
            { "upTo": 0, "points": 0 },
            { "upTo": null, "points": -30, "note": "Slippery roads possible" }
          ] },
        { "id": "dark", "label": "Dusk / darkness", "input": "darkness", "unit": "%", "dec": 0,
          "bands": [
            { "upTo": 0, "points": 0 },
            { "upTo": 25, "points": -4, "note": "Dusk: light is fading" },
            { "upTo": 50, "points": -9, "note": "Twilight: harder to see" },
            { "upTo": 75, "points": -15, "note": "Getting dark: lights needed" },
            { "upTo": null, "points": -22, "note": "Dark: less pleasant and harder to see, lights needed" }
          ] },
        { "id": "moon", "label": "Bright moon, clear sky", "input": "moonlight", "display": "flag",
          "bands": [
            { "upTo": 0, "points": 0 },
            { "upTo": null, "points": 5, "note": "Moonlit and clear: better to see and nicer to ride" }
          ] },
        { "id": "thunder", "label": "Thunderstorm (1 = thunder, 2 = severe)", "input": "thunder",
          "bands": [
            { "upTo": 0, "points": 0 },
            { "upTo": 1, "points": -30, "note": "Thunderstorm: lightning risk, stay inside" },
            { "upTo": null, "points": -40, "note": "Severe thunderstorm: stay inside" }
          ] },
        { "id": "intervals", "label": "Calm and dry (ideal for intervals)", "input": "intervalWeather", "display": "flag",
          "bands": [
            { "upTo": 0, "points": 0 },
            { "upTo": null, "points": 4, "note": "Little wind, dry, 8-18°C: good for intervals" }
          ] }
      ],
      "verdicts": [
        { "min": 80, "label": "Great ride weather", "icon": "😎", "color": "#2ecc71", "bg": ["#0e1420", "#0f3d3a"] },
        { "min": 60, "label": "Good to ride", "icon": "🙂", "color": "#a3e635", "bg": ["#0e1420", "#16382a"] },
        { "min": 40, "label": "Okay if you must", "icon": "😐", "color": "#facc15", "bg": ["#0e1420", "#3d3216"] },
        { "min": 20, "label": "Poor weather", "icon": "🙁", "color": "#fb923c", "bg": ["#0e1420", "#3d2216"] },
        { "min": 8, "label": "Bad weather", "icon": "🌧️", "color": "#f87171", "bg": ["#0e1420", "#3d1d1d"] },
        { "min": 0, "label": "Stay inside", "icon": "⛈️", "color": "#ef4444", "bg": ["#0e1420", "#3d1626"] }
      ]
    }
  },

  "velominati": [
    { "rule": 9, "text": "If you are out riding in bad weather, it means you are a badass. Period.",
      "when": { "input": "comfort", "op": "lt", "value": 40 } },
    { "rule": 67, "text": "Do your time in the wind.",
      "when": { "input": "ff", "op": "gte", "value": 10.8 } },
    { "rule": 21, "text": "Cold weather gear is for cold weather.",
      "when": [{ "input": "rideTemp", "op": "gte", "value": 14 }, { "input": "comfort", "op": "gte", "value": 60 }] }
  ],

  "rainJacket": {
    "title": "Rain jacket?",
    "levels": [
      { "when": { "input": "rainIntensity", "op": "gt", "value": 0.5 }, "label": "Yes, definitely", "icon": "☔", "text": "It is raining properly right now." },
      { "when": { "input": "rainIntensity", "op": "gt", "value": 0.05 }, "label": "Yes", "icon": "🌦️", "text": "Light rain is falling." },
      { "when": [ { "input": "rain1h", "op": "gt", "value": 0.2 }, { "input": "rideTemp", "op": "lt", "value": 12 } ], "label": "Take one along", "icon": "🎒", "text": "It rained in the last hour and it is cool." },
      { "when": [ { "input": "rh", "op": "gte", "value": 95 }, { "input": "rideTemp", "op": "lt", "value": 10 } ], "label": "Take one along", "icon": "🎒", "text": "Very damp and cold air: a showerproof layer helps." },
      { "when": { "input": "n", "op": "gte", "value": 5 }, "label": "No", "icon": "☁️", "text": "No rain at the moment." },
      { "label": "No", "icon": "🌤️", "text": "No rain at the moment." }
    ]
  },

  "clothing": {
    "bands": [
      { "upTo": 0, "label": "Freezing",
        "items": ["Windproof jacket", "Thermal base layer", "Long thermal bib tights", "Winter gloves", "Skullcap", "Overshoes", "Neck warmer"] },
      { "upTo": 5, "label": "Very cold",
        "items": ["Thermal jersey", "Windproof jacket", "Base layer", "Long bib tights", "Gloves", "Skullcap", "Overshoes", "Neck warmer"] },
      { "upTo": 10, "label": "Cold",
        "items": ["Short jersey", "Windproof jacket", "Leg warmers or long tights", "Gloves", "Skullcap", "Overshoes", "Neck warmer"] },
      { "upTo": 13.9, "label": "Cool",
        "items": ["Short jersey", "Windproof jacket", "Knee or leg warmers"] },
      { "upTo": 18, "label": "Mild",
        "items": ["Short jersey", "Base layer", "Arm warmers", "Bib shorts"] },
      { "upTo": null, "label": "Warm (short/short)",
        "items": ["Short jersey", "Bib shorts"],
        "note": "No leg warmers, no arm warmers." }
    ],
    "extras": [
      { "when": { "input": "rainIntensity", "op": "gt", "value": 0.05 }, "items": ["Rain jacket", "Mudguards"] },
      { "when": { "input": "rain1h", "op": "gt", "value": 0.1 }, "items": ["Mudguards"], "warning": "Wet roads: take mudguards to keep spray off you and your bike." },
      { "when": { "input": "rain6h", "op": "gt", "value": 1 }, "items": ["Mudguards"] },
      { "when": [
          { "input": "rideTemp", "op": "lt", "value": 12 },
          { "input": "rainIntensity", "op": "gt", "value": 0.05 }
        ], "items": ["Waterproof gloves", "Waterproof overshoes"] },
      { "when": { "input": "qg", "op": "gte", "value": 300 }, "items": ["Sunglasses"] },
      { "when": { "input": "qg", "op": "gte", "value": 600 }, "items": ["Sunscreen"] },
      { "when": { "input": "rideTemp", "op": "gte", "value": 25 }, "items": ["Extra bottle"] },
      { "when": { "input": "ta", "op": "gte", "value": 25 }, "warning": "Heat: drink regularly, even if you are not thirsty." },
      { "when": [{ "input": "ff", "op": "gte", "value": 7 }, { "input": "rideTemp", "op": "lt", "value": 8 }], "items": ["Windproof gloves", "Neck warmer"] },
      { "when": { "input": "dryCold", "op": "gte", "value": 1 }, "items": ["Lip balm"], "warning": "Dry, cold air: lip balm and a buff over your nose and mouth help." },
      { "when": { "input": "ta", "op": "lt", "value": -10 }, "items": ["Ski goggles"], "warning": "Extreme cold: ski goggles protect your eyes and face from the icy wind." },
      { "when": { "input": "sunGlare", "op": "gte", "value": 1 }, "items": ["Sunglasses"], "warning": "Low sun: glare can hide obstacles. Wear sunglasses." },
      { "when": [{ "input": "qg", "op": "gte", "value": 600 }, { "input": "rideTemp", "op": "gte", "value": 18 }], "items": ["Sun sleeves or light jersey"] },
      { "when": [{ "input": "darkness", "op": "gt", "value": 0 }, { "input": "night", "op": "lt", "value": 1 }, { "input": "rideTemp", "op": "lt", "value": 12 }], "items": ["Extra layer in your pocket"], "warning": "It gets dark soon and cooler: take an extra layer in case you ride longer." },
      { "when": { "input": "leafRisk", "op": "gte", "value": 1 }, "warning": "Wet leaves and mud: slippery, especially in corners and on cycle paths. Brake early." },
      { "when": { "input": "coldEastWind", "op": "gte", "value": 1 }, "warning": "Cold easterly wind: it feels colder than the temperature suggests." },
      { "when": { "input": "bridgeIce", "op": "gte", "value": 1 }, "warning": "Near freezing and damp: bridges and viaducts can be icy first." },
      { "when": [{ "input": "foggyCold", "op": "gte", "value": 1 }], "warning": "Cold fog: damp, cold and slippery. Dress warmer and use lights." },
      { "when": [{ "input": "rainIntensity", "op": "gt", "value": 2 }, { "input": "darkness", "op": "gt", "value": 0 }], "warning": "Heavy rain in the dark: very poor visibility. Consider skipping the ride." },
      { "when": { "input": "night", "op": "gte", "value": 1 }, "items": ["Front and rear lights", "Reflective vest"], "warning": "It is dark: use front and rear lights and wear a reflective vest." },
      { "when": [{ "input": "darkness", "op": "gt", "value": 0 }, { "input": "night", "op": "lt", "value": 1 }, { "input": "dawn", "op": "lt", "value": 1 }], "items": ["Front and rear lights"], "warning": "Twilight: it is getting dark, use your lights." },
      { "when": [{ "input": "darkness", "op": "gt", "value": 0 }, { "input": "night", "op": "lt", "value": 1 }, { "input": "dawn", "op": "gte", "value": 1 }], "items": ["Front and rear lights"], "warning": "Twilight: it is getting light, but keep your lights on until it is fully light." },
      { "when": { "input": "thunder", "op": "gte", "value": 1 }, "warning": "Thunderstorm: lightning is dangerous on a bike. Stay inside." },
      { "when": { "input": "moonlight", "op": "gte", "value": 1 }, "warning": "Clear sky and a bright moon: nice moonlit ride, but still use your lights." },
      { "when": [{ "input": "darkSoon", "op": "gte", "value": 1 }, { "input": "darkness", "op": "lte", "value": 0 }], "items": ["Front and rear lights"], "warning": "It gets dark within 2 hours: take lights in case you are still out." },
      { "when": { "input": "vv", "op": "lte", "value": 2000 }, "items": ["Front and rear lights"], "warning": "Fog or mist: less pleasant to ride and you are harder to see. Use lights and ride carefully." },
      { "when": { "input": "snow", "op": "gte", "value": 1 }, "warning": "Snow: take the mountainbike, its wider tyres grip better than a road bike." },
      { "when": { "input": "iceRisk", "op": "gte", "value": 1 }, "warning": "Ice risk: roads can be slippery. Take care or take the city bike." },
      { "when": { "input": "saltRisk", "op": "gte", "value": 1 }, "warning": "Road salt likely: bad for your bike (corrosion on chain, brakes and frame). Rinse it off thoroughly after the ride." }
    ]
  },

  "cleaning": {
    "title": "Bike cleaning after the ride",
    "rules": [
      { "id": "rain-now", "label": "Rain right now", "input": "rainIntensity", "unit": "mm/h", "dec": 1,
        "bands": [
          { "upTo": 0.05, "points": 0 },
          { "upTo": 0.5, "points": 2 },
          { "upTo": 2, "points": 3 },
          { "upTo": null, "points": 4 }
        ] },
      { "id": "rain-1h", "label": "Rain last hour (spray from the road)", "input": "rain1h", "unit": "mm", "dec": 1,
        "bands": [
          { "upTo": 0.1, "points": 0 },
          { "upTo": 1, "points": 2 },
          { "upTo": null, "points": 3 }
        ] },
      { "id": "rain-6h", "label": "Rain last 6 hours", "input": "rain6h", "unit": "mm", "dec": 1,
        "bands": [
          { "upTo": 0.5, "points": 0 },
          { "upTo": 3, "points": 1 },
          { "upTo": null, "points": 2 }
        ] },
      { "id": "rain-24h", "label": "Rain last 24 hours (dirty roads)", "input": "rain24h", "unit": "mm", "dec": 1,
        "bands": [
          { "upTo": 1, "points": 0 },
          { "upTo": 5, "points": 1 },
          { "upTo": null, "points": 2 }
        ] },
      {
        "id": "damp",
        "label": "Very damp air (wet roads, mist)",
        "input": "rh",
        "unit": "%",
        "bands": [
          { "upTo": 94.9, "points": 0 },
          { "upTo": null, "points": 2 }
        ]
      },
      { "id": "salt", "label": "Road salt likely (cold and wet)", "input": "saltRisk", "display": "flag",
        "bands": [
          { "upTo": 0, "points": 0 },
          { "upTo": null, "points": 2, "note": "Rinse off salt" }
        ] }
    ],
    "tips": [
      { "when": { "input": "saltRisk", "op": "gte", "value": 1 }, "text": "Road salt: also rinse the brake calipers, rims or discs, derailleurs and bottom bracket area." },
      { "when": { "input": "rain24h", "op": "gte", "value": 5 }, "text": "Several wet days: lube the chain more often, it washes out quickly." },
      { "when": [{ "input": "rain6h", "op": "gte", "value": 3 }, { "input": "ta", "op": "gte", "value": 5 }], "text": "Muddy roads: brush the cassette and derailleurs and clean the brake pads." }
    ],
    "levels": [
      { "min": 0, "label": "No cleaning needed", "icon": "✨", "text": "Dry roads. Wipe the chain if it is dusty." },
      { "min": 2, "label": "Quick rinse and wipe", "icon": "🧽", "text": "Wipe down the frame and drivetrain, dry the chain, cassette and chainrings to prevent rust and add a drop of chain lube." },
      { "min": 4, "label": "Rinse, brush and re-lube", "icon": "🚿", "text": "Rinse off the grime, brush the drivetrain, dry the chain, cassette and chainrings to prevent rust and re-lube the chain." },
      { "min": 7, "label": "Full clean", "icon": "🧼", "text": "Degrease the drivetrain, wash and dry the bike, lube the chain and check brakes and pads." }
    ]
  }
}
